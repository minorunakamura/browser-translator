{
  "manifest_version": 3,
  "name": "Browser Translator",
  "version": "0.1.0",
  "description": "Translate web pages with a local llama-server (PLaMo 3 Translate).",
  "permissions": ["activeTab", "contextMenus", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "background": {
    "service_worker": "background.js"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": false
  },
  "action": {
    "default_title": "Browser Translator"
  },
  "commands": {
    "toggle-reader": {
      "suggested_key": { "default": "Alt+Shift+R" },
      "description": "リーダー表示を開く・閉じる"
    }
  }
}
