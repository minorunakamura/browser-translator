{
  "name": "browser-translator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.23.0",
  "scripts": {
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "oxlint --type-aware --deny-warnings",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.ts",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.9",
    "@types/chrome": "0.3.8",
    "@types/node": "24.19.4",
    "oxlint": "1.95.0",
    "oxlint-tsgolint": "7.0.2009",
    "typescript": "7.0.2",
    "vite": "8.4.0",
    "vitest": "5.1.2"
  }
}
